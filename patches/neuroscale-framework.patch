+class CoreHandshakes(MicroNet):
+    """Silent pairs or four-core cliques at constant neuron count and occupancy.
+
+    Both topologies stay within tiles, removing inter-tile routing energy.
+    Their different ratios of nonempty tables to directed links identify the
+    two handshake coefficients. Unconnected neurons provide the reference.
+    """
+
+    def __init__(self, cores, groups, topology="pairs"):
+        super().__init__()
+        self.cores, self.group_count = cores, groups
+        self.topology = topology
+
+    def build(self):
+        self.neurons = [
+            NodeGroup(NSLIF(threshold=32000, bias=0), 1) for _ in range(self.cores)
+        ]
+        if self.group_count:
+            if self.topology in ("cliques", "reciprocal", "triangles"):
+                size = {"cliques": 4, "reciprocal": 2, "triangles": 3}[self.topology]
+                edges = [
+                    (source, target)
+                    for first in range(0, self.group_count * size, size)
+                    for source in range(first, first + size)
+                    for target in range(first, first + size)
+                    if source != target
+                ]
+            else:
+                edges = [(2 * i, 2 * i + 1) for i in range(self.group_count)]
+            self.synapses = [
+                EdgeGroup(
+                    self.neurons[source],
+                    self.neurons[target],
+                    PSP(weight=1, delay=1),
+                    edges=[(0, 0)],
+                )
+                for source, target in edges
+            ]
+
+    def placements(self):
+        return [Place(group, core, "quiet") for core, group in enumerate(self.neurons)]
 
 
