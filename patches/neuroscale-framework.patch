+def fit_handshake_components(rows: list[dict[str, str]]) -> tuple[Metric, Metric]:
+    """Fit per-nonempty-table and per-link energy at fixed neuron occupancy."""
+    points = []
+    for row in marginal_rows(rows):
+        if row.get("variant") in ("reciprocal", "triangles"):
+            continue  # Keep the energy fit independent of latency probes.
+        tables = parse_float(row.get("active handshake tables"))
+        links = parse_float(row.get("directed core links"))
+        energy = parse_float(row.get(ENERGY_COL))
+        if tables is None or links is None or energy is None:
+            raise RegressionError(
+                "handshake calibration requires table and link counts"
+            )
+        if min(tables, links) < 0 or not all(
+            math.isfinite(value) for value in (tables, links, energy)
+        ):
+            raise RegressionError(
+                "handshake measurements must be finite with nonnegative counts"
+            )
+        points.append((tables, links, energy * MILLIJOULE_TO_JOULE))
+    references = [
+        energy for tables, links, energy in points if tables == 0 and links == 0
+    ]
+    if not references:
+        raise RegressionError("handshake calibration requires an unconnected reference")
+    baseline = sum(references) / len(references)
+    aa = sum(a * a for a, _, _ in points)
+    ab = sum(a * b for a, b, _ in points)
+    bb = sum(b * b for _, b, _ in points)
+    ay = sum(a * (energy - baseline) for a, _, energy in points)
+    by = sum(b * (energy - baseline) for _, b, energy in points)
+    determinant = aa * bb - ab * ab
+    if determinant <= 1e-12 * aa * bb:
+        raise RegressionError(
+            "handshake calibration needs independent table/link counts; run pairs and cliques"
+        )
+    base = (ay * bb - by * ab) / determinant
+    link = (by * aa - ay * ab) / determinant
+    if min(base, link) < 0 or not all(math.isfinite(value) for value in (base, link)):
+        raise RegressionError("handshake components must be finite and nonnegative")
+    return Metric(energy=base), Metric(energy=link)
+
+
+def fit_handshake_latency(rows, sync_latency):
+    """Effective endpoint work from recurrent, intra-tile silent groups.
+
+    The critical core has two nonempty tables and 2, 4 or 6 incident links;
+    parallel copies do not multiply the observed latency. Remove the source
+    chip's fixed sync latency before assigning the two-table intercept.
+    """
+    degrees = {"reciprocal": 2, "triangles": 4, "cliques": 6}
+    points = [
+        (degrees[row["variant"]], float(row[LATENCY_COL]) * MILLISECOND_TO_SECOND)
+        for row in marginal_rows(rows)
+        if row.get("variant") in degrees
+    ]
+    if len({degree for degree, _ in points}) < 3:
+        raise RegressionError(
+            "handshake latency needs reciprocal pairs, triangles and cliques"
+        )
+    fit = linear_fit(points)
+    base = (fit.intercept - sync_latency) / 2.0
+    if not all(math.isfinite(cost) and cost >= 0 for cost in (base, fit.slope)):
+        raise RegressionError("handshake latency costs must be finite and nonnegative")
+    return base, fit.slope
+
+
+def isolate_axon_energy(
+    metrics: dict[str, Metric], source_soma_rows: list[dict[str, str]]
+) -> dict[str, Metric]:
+    """Remove source soma work from whole-chip axon energy slopes.
+
+    Scan adds one non-refractory source neuron per axon. The spiking sweep
+    replaces one-shot sources with periodic sources, adding spike-out energy.
+    Egress and arrival cannot be separated by these sweeps: charge their sum
+    in message_in, with zero separate axon_out energy. Latencies are unchanged.
+    The soma measurements must be from the chip that ran the axon sweep, which
+    can differ from the chip whose architecture we are generating.
+    """
+    rows = marginal_rows(source_soma_rows)
+    fits = {}
+    for population in ("inactive", "active", "spiking"):
+        fit, _ = fit_metric([r for r in rows if r.get("variant") == population], soma_x)
+        if fit is None:
+            raise RegressionError(
+                f"axon energy needs source-chip soma {population} measurements"
+            )
+        fits[population] = fit
+    source_access_update = fits["inactive"].slope
+    source_spike = fits["spiking"].slope - fits["active"].slope
+    corrected = dict(metrics)
+    for name, subtraction in (
+        ("scan_axon", source_access_update),
+        ("message_in", source_spike),
+    ):
+        original = metrics[name]
+        if original.energy is None:
+            raise RegressionError(f"missing {name} energy")
+        energy = original.energy - subtraction
+        if energy < 0:
+            raise RegressionError(
+                f"isolated {name} energy is negative ({energy:.6e} J)"
+            )
+        corrected[name] = Metric(energy=energy, latency=original.latency)
+    return corrected
 
 
