+"""Regression tests for separating axon energy from source-neuron work."""
+
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import regress_microbenchmarks as regression
+
+
+class AxonEnergyCalibration(unittest.TestCase):
+    def soma_rows(self):
+        # Slopes are 10 pJ for a quiet source and 17 pJ for a firing source.
+        return [
+            {
+                "variant": population,
+                "num neurons (total)": str(n),
+                regression.ENERGY_COL: str((100 + n * slope) * 1e-9),
+                regression.LATENCY_COL: "0.0",
+            }
+            for population, slope in (("inactive", 10), ("active", 10), ("spiking", 17))
+            for n in (2, 8)
+        ]
+
+    def test_subtracts_source_energy_and_preserves_latency(self):
+        metrics = {
+            "scan_axon": regression.Metric(30e-12, 3e-9),
+            "message_in": regression.Metric(50e-12, 5e-9),
+            "read_synapse": regression.Metric(2e-12, 2e-9),
+        }
+        corrected = regression.isolate_axon_energy(metrics, self.soma_rows())
+        self.assertAlmostEqual(corrected["scan_axon"].energy, 20e-12, delta=1e-24)
+        self.assertAlmostEqual(corrected["message_in"].energy, 43e-12, delta=1e-24)
+        for key in metrics:
+            self.assertEqual(corrected[key].latency, metrics[key].latency)
+        self.assertEqual(
+            corrected["read_synapse"].energy, metrics["read_synapse"].energy
+        )
+        self.assertEqual(metrics["scan_axon"].energy, 30e-12)
+
+    def test_rejects_missing_source_calibration(self):
+        with self.assertRaises(regression.RegressionError):
+            regression.isolate_axon_energy({}, [])
+
+    def test_rejects_negative_isolated_cost(self):
+        metrics = {
+            "scan_axon": regression.Metric(1e-12, 3e-9),
+            "message_in": regression.Metric(50e-12, 5e-9),
+        }
+        with self.assertRaises(regression.RegressionError):
+            regression.isolate_axon_energy(metrics, self.soma_rows())
+
+
+class HandshakeComponentCalibration(unittest.TestCase):
+    def rows(self, layouts=((0, 0), (2, 1), (8, 4), (8, 12), (32, 48))):
+        rows = []
+        for tables, links in layouts:
+            for ticks in (12, 24):
+                total_nJ = (
+                    500
+                    + 99 * links
+                    + 25 * tables
+                    + ticks * (700 + 0.355 * tables + 0.171 * links)
+                    - 674
+                )
+                rows.append(
+                    {
+                        "variant": f"t{tables}_l{links}",
+                        "num neurons (total)": "64",
+                        "active handshake tables": str(tables),
+                        "directed core links": str(links),
+                        "timesteps": str(ticks),
+                        regression.DYNAMIC_ENERGY_COL: str(total_nJ * 1e-6),
+                        regression.TOTAL_TIME_COL: str(ticks * 1e-3),
+                        regression.ENERGY_COL: str(total_nJ * 1e-6 / ticks),
+                        regression.LATENCY_COL: "0.001",
+                    }
+                )
+        return rows
+
+    def test_recovers_independent_table_and_link_energy(self):
+        fixed, link = regression.fit_handshake_components(self.rows())
+        self.assertAlmostEqual(fixed.energy, 0.355e-9, delta=1e-20)
+        self.assertAlmostEqual(link.energy, 0.171e-9, delta=1e-20)
+
+    def test_rejects_collinear_pair_only_sweep(self):
+        with self.assertRaises(regression.RegressionError):
+            regression.fit_handshake_components(self.rows(((0, 0), (2, 1), (8, 4))))
+
+    def test_requires_zero_link_reference(self):
+        with self.assertRaises(regression.RegressionError):
+            regression.fit_handshake_components(self.rows(((2, 1), (8, 12))))
+
+
+class SyncArchitectureGeneration(unittest.TestCase):
+    def test_generates_chip_sync_attributes_for_all_neuron_kinds(self):
+        names = (
+            "soma_access",
+            "soma_update",
+            "soma_spike_out",
+            "scan_axon",
+            "core_handshake",
+            "core_handshake_base",
+            "message_in",
+            "read_synapse",
+            "axon_out",
+        )
+        values = {name: regression.Metric(0.0, 0.0) for name in names}
+        values["core_handshake"] = regression.Metric(0.171e-9, 7e-9)
+        values["core_handshake_base"] = regression.Metric(0.355e-9, 17e-9)
+        hops = {
+            direction: regression.Metric(0.0, 0.0)
+            for direction in ("north", "east", "south", "west")
+        }
+        for kind in ("lif", "rw", "lca"):
+            with self.subTest(kind=kind):
+                arch = regression.build_architecture_dict(
+                    values,
+                    hops,
+                    kind,
+                    sync_latency=1e-6,
+                    sync_energy=687e-9,
+                )["architecture"]
+                self.assertEqual(
+                    arch["attributes"]["energy_sync"],
+                    {
+                        "per_sending_core": 0.355e-9,
+                        "per_receiving_core": 0.355e-9,
+                        "per_message_sent": 0.0,
+                        "per_message_received": 0.171e-9,
+                    },
+                )
+                self.assertEqual(
+                    arch["attributes"]["latency_sync"],
+                    {
+                        "per_sending_core": 17e-9,
+                        "per_receiving_core": 17e-9,
+                        "per_message_sent": 7e-9,
+                        "per_message_received": 7e-9,
+                    },
+                )
+                synapse = arch["tile"][0]["core"][0]["synapse"][0]["attributes"]
+                for name in (
+                    "energy_handshake_message",
+                    "energy_handshake_table",
+                    "energy_core_handshake",
+                    "energy_core_handshake_base",
+                ):
+                    self.assertNotIn(name, synapse)
+                self.assertEqual(arch["attributes"]["latency_timestep_fixed"], 1e-6)
+                self.assertEqual(arch["attributes"]["energy_timestep_fixed"], 687e-9)
+
+
+class HandshakeLatencyCalibration(unittest.TestCase):
+    def rows(self):
+        return [
+            {
+                "variant": topology,
+                "num neurons (total)": "64",
+                "timesteps": str(ticks),
+                regression.TOTAL_TIME_COL: str(
+                    0.001 + ticks * (1000 + 2 * 17 + degree * 7) * 1e-6
+                ),
+                regression.DYNAMIC_ENERGY_COL: "0.0",
+                regression.ENERGY_COL: "0.0",
+                regression.LATENCY_COL: "0.0",
+            }
+            for topology, degree in (
+                ("reciprocal", 2),
+                ("triangles", 4),
+                ("cliques", 6),
+            )
+            for ticks in (12, 24)
+        ]
+
+    def test_removes_startup_and_fixed_sync_using_critical_core_degree(self):
+        base, link = regression.fit_handshake_latency(self.rows(), 1000e-9)
+        self.assertAlmostEqual(base, 17e-9, delta=1e-20)
+        self.assertAlmostEqual(link, 7e-9, delta=1e-20)
+
+    def test_requires_all_three_recurrent_degrees(self):
+        with self.assertRaises(regression.RegressionError):
+            regression.fit_handshake_latency(self.rows()[:4], 1000e-9)
+
+    def test_rejects_negative_processing_cost(self):
+        with self.assertRaises(regression.RegressionError):
+            regression.fit_handshake_latency(self.rows(), 2000e-9)
+
+
+if __name__ == "__main__":
+    unittest.main()
